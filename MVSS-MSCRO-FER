-- ===== BUSCAR ARMA (ignora el cuchillo) =====
local function isKnife(name)
    name = name:lower()
    return name:find("knife") or name:find("cuchillo") or name:find("blade") or name:find("dagger")
end

local function findWeapon()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    if weaponName then
        return backpack:FindFirstChild(weaponName)
    end

    local fallback
    for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") and not isKnife(t.Name) then
            local n = t.Name:lower()
            if n:find("gun") or n:find("revolver") or n:find("pistol")
            or n:find("arma") or n:find("sheriff") then
                return t
            end
            fallback = fallback or t
        end
    end
    return fallback
end

-- ¿El arma está realmente disponible para usarse ahora?
local function isAvailable(weapon)
    if not weapon or not weapon:IsA("Tool") then return false end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack or weapon.Parent ~= backpack then return false end
    if weapon.Enabled == false then return false end
    if os.clock() - lastShot < SHOT_COOLDOWN then return false end
    return true
end

-- ===== MACRO =====
local function runMacro()
    if busy then return end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if char:FindFirstChildOfClass("Tool") then return end -- cuchillo en mano = libre

    local weapon = findWeapon()
    if not isAvailable(weapon) then
        setStatus(weapon and "Arma no lista" or "Arma no disponible")
        return
    end

    busy = true
    local ok, err = pcall(function()
        setStatus("Sacando " .. weapon.Name)
        local cycleStart = os.clock()
        hum:EquipTool(weapon)
        local t = os.clock()
        while weapon.Parent ~= char and os.clock() - t < 0.5 do
            task.wait()
        end
        if weapon.Parent ~= char then
            setStatus("No pudo sacarla")
            return
        end
        if EQUIP_WAIT > 0 then task.wait(EQUIP_WAIT) end
        if weapon.Parent ~= char or weapon.Enabled == false then
            hum:UnequipTools()
            setStatus("Arma no lista")
            return
        end
        setStatus("Disparando")
        weapon:Activate()
        lastShot = os.clock()
        if EXTRA_CLICK and mouse1click then
            pcall(mouse1click)
        end
        if UNEQUIP_DELAY > 0 then task.wait(UNEQUIP_DELAY) end
        local remaining = CYCLE_TIME - (os.clock() - cycleStart)
        if remaining > 0 then task.wait(remaining) end
        hum:UnequipTools()
        setStatus("Listo: " .. weapon.Name)
    end)
    if not ok then setStatus("Error: " .. tostring(err):sub(1, 25)) end
    busy = false
end

-- ===== DETECTAR TAPS =====
local touches = {}

UIS.InputBegan:Connect(function(input, processed)
    if not enabled or processed then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        touches[input] = {pos = input.Position, t = os.clock()}
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        task.spawn(runMacro)
    end
end)

UIS.InputEnded:Connect(function(input)
    local info = touches[input]
    if not info then return end
    touches[input] = nil
    if enabled
    and (input.Position - info.pos).Magnitude < 20
    and os.clock() - info.t < 0.25 then
        task.spawn(runMacro)
    end
end)

