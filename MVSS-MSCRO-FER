local IMAGE_FILE = "fer_menu.jpg"
local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function b64decode(s)
    local map = {}
    for i = 1, #CHARS do map[CHARS:byte(i)] = i - 1 end
    local out, buf, bits = {}, 0, 0
    for i = 1, #s do
        local v = map[s:byte(i)]
        if v then
            buf = buf * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local byte = math.floor(buf / 2 ^ bits) % 256
                out[#out + 1] = string.char(byte)
                buf = buf % (2 ^ bits)
            end
        end
    end
    return table.concat(out)
end

local function getImage()
    if not (writefile and getcustomasset) then return nil end
    local ok, asset = pcall(function()
        local exists = isfile and isfile(IMAGE_FILE)
        if not exists then
            writefile(IMAGE_FILE, b64decode(IMAGE_B64))
        end
        return getcustomasset(IMAGE_FILE)
    end)
    if ok then return asset end
    return nil
end

